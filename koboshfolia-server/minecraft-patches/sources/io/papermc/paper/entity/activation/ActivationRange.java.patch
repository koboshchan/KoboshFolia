+    // Kobosh start - configurable movement immunity duration
+    /**
+     * How long an entity stays force-activated after being airborne, moving, or pushed by fluid.
+     *
+     * <p>Vanilla/Paper hardcodes 100 ticks. Because {@link #checkEntityImmunities} re-runs once the
+     * granted immunity lapses, an entity that is still airborne or still moving simply re-earns its
+     * immunity - so lowering this never leaves a falling entity stuck mid-air. It only shortens the
+     * tail during which an entity that has already settled keeps ticking at full cost.
+     */
+    private static int movementImmunityTicks(final Entity entity) {
+        if (!com.kobosh.koboshfolia.KoboshConfig.aggressiveFarmEarEnabled) {
+            return 100;
+        }
+        // Keep vanilla behaviour anywhere a player could be watching.
+        final int radius = com.kobosh.koboshfolia.KoboshConfig.aggressiveFarmEarPlayerRadius;
+        if (radius > 0 && entity.level().hasNearbyAlivePlayer(entity.getX(), entity.getY(), entity.getZ(), radius)) {
+            return 100;
+        }
+        return com.kobosh.koboshfolia.KoboshConfig.aggressiveFarmEarMovementImmunityTicks;
+    }
