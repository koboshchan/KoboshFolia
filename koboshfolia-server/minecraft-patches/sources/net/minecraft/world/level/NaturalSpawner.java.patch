+    // Kobosh start - Lithium - cache rough biome lookups while counting mobs
+    private static Biome getRoughBiome(final BlockPos pos, final ChunkAccess chunk, final it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap<Biome> cache) {
+        final int quartX = QuartPos.fromBlock(pos.getX());
+        final int quartY = QuartPos.fromBlock(pos.getY());
+        final int quartZ = QuartPos.fromBlock(pos.getZ());
+        // Quart coordinates are world-absolute, so this key is unique across chunks. The packing
+        // range (26/12/26 bits) comfortably covers quart-space for the maximum world size.
+        final long key = BlockPos.asLong(quartX, quartY, quartZ);
+        Biome cached = cache.get(key);
+        if (cached == null) {
+            cached = chunk.getNoiseBiome(quartX, quartY, quartZ).value();
+            cache.put(key, cached);
+        }
+
+        return cached;
+    }
