Subject: [PATCH] Ender Chest: 6 rows by permission


diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index 8274afe0d07c50ece420b1d3cb20165ed0162acb..7d3a0cb04dab14f2f74931b41f68632553b1e418 100644
--- a/net/minecraft/server/players/PlayerList.java
+++ b/net/minecraft/server/players/PlayerList.java
@@ -947,6 +947,25 @@ public abstract class PlayerList {
         player.getBukkitEntity().recalculatePermissions(); // CraftBukkit
         this.server.getCommands().sendCommands(player);
         } // Paper - Add sendOpLevel API
+
+        // Kobosh start - Barrels and enderchests 6 rows
+        org.bukkit.craftbukkit.entity.CraftHumanEntity bukkit = player.getBukkitEntity();
+        if (bukkit.hasPermission("kobosh.enderchest.rows.six")) {
+            player.sixRowEnderchestSlotCount = 54;
+        } else if (bukkit.hasPermission("kobosh.enderchest.rows.five")) {
+            player.sixRowEnderchestSlotCount = 45;
+        } else if (bukkit.hasPermission("kobosh.enderchest.rows.four")) {
+            player.sixRowEnderchestSlotCount = 36;
+        } else if (bukkit.hasPermission("kobosh.enderchest.rows.three")) {
+            player.sixRowEnderchestSlotCount = 27;
+        } else if (bukkit.hasPermission("kobosh.enderchest.rows.two")) {
+            player.sixRowEnderchestSlotCount = 18;
+        } else if (bukkit.hasPermission("kobosh.enderchest.rows.one")) {
+            player.sixRowEnderchestSlotCount = 9;
+        } else {
+            player.sixRowEnderchestSlotCount = -1;
+        }
+        // Kobosh end - Barrels and enderchests 6 rows
     }
 
     // Paper start - whitelist verify event / login event
diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
