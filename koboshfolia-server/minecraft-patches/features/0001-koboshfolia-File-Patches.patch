+    private long refreshNearbyChunkHot() {
+        long total = 0L;
+        int searchRadius = ((ServerLevel)this.level()).moonrise$getViewDistanceHolder().getViewDistances().tickViewDistance();
+        for (int chunkX = this.moonrise$getSectionX() - searchRadius; chunkX <= this.moonrise$getSectionX() + searchRadius; ++chunkX) {
+            for (int chunkZ = this.moonrise$getSectionZ() - searchRadius; chunkZ <= this.moonrise$getSectionZ() + searchRadius; ++chunkZ) {
+                LevelChunk targetChunk = this.level().getChunkIfLoaded(chunkX, chunkZ);
+                if (targetChunk != null) {
+                    total += targetChunk.getChunkHot().getAverage();
+                }
+            }
+        }
+        return total;
+    }
+
