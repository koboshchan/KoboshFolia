From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: koboshchan <lucaszhang1001@gmail.com>
Date: Wed, 20 May 2026 08:35:35 -0700
Subject: [PATCH] Krypton: set Netty allocator maxOrder=9 (4MiB arenas)

Reduces memory waste and GC pressure; Minecraft's max packet is 2MiB
so the default 16MiB arenas are unnecessarily large.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>

diff --git a/src/main/java/org/bukkit/craftbukkit/Main.java b/src/main/java/org/bukkit/craftbukkit/Main.java
index 8a4c9335d57cdf2177cd88ffc5a6a8e6cc902c57..da5d57b76ee67a18849f8d96112ef98483977b74 100644
--- a/src/main/java/org/bukkit/craftbukkit/Main.java
+++ b/src/main/java/org/bukkit/craftbukkit/Main.java
@@ -23,6 +23,7 @@ public class Main {
 
     public static void main(String[] args) {
         if (System.getProperty("jdk.nio.maxCachedBufferSize") == null) System.setProperty("jdk.nio.maxCachedBufferSize", "262144"); // Paper - cap per-thread NIO cache size; https://www.evanjones.ca/java-bytebuffer-leak.html
+        if (System.getProperty("io.netty.allocator.maxOrder") == null) System.setProperty("io.netty.allocator.maxOrder", "9"); // Kobosh - Krypton: 4MiB Netty arenas
 
         if (System.getProperty("joml.nounsafe") == null) {
             System.setProperty("joml.nounsafe", "true");
