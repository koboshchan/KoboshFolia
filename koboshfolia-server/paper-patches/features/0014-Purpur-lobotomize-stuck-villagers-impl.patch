Subject: [PATCH] Purpur: lobotomize stuck villagers impl

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>

diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftVillager.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftVillager.java
index 1ad99732f60f2182285fba1b52c01c61418b6262..778b61778533960a17f5d01ead0c438e744e3731 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftVillager.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftVillager.java
@@ -244,4 +244,9 @@ public class CraftVillager extends CraftAbstractVillager implements Villager {
     public void restock() {
         this.getHandle().restock();
     }
+
+    @Override
+    public boolean isLobotomized() {
+        return getHandle().isLobotomized();
+    }
 }
