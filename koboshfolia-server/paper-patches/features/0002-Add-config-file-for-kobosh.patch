diff --git a/src/main/java/org/kobosh/koboshfolia/KoboshConfig.java b/src/main/java/org/kobosh/koboshfolia/KoboshConfig.java
new file mode 100644
index 0000000000000000000000000000000000000000..a3f9a422a04233b46f56e7ade1d1518134fab691
--- /dev/null
+++ b/src/main/java/org/kobosh/koboshfolia/KoboshConfig.java
@@ -0,0 +1,36 @@
+package org.kobosh.koboshfolia;
+
+import com.google.common.base.Throwables;
+import org.bukkit.Bukkit;
+import org.bukkit.configuration.InvalidConfigurationException;
+import org.bukkit.configuration.file.YamlConfiguration;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.logging.Level;
+
+public class KoboshConfig {
+    private static final String HEADER = "This is the main configuration file for KoboshFolia.\n";
+    private static File CONFIG_FILE;
+    public static YamlConfiguration config;
+
+    public static void init(File configFile) {
+        CONFIG_FILE = configFile;
+        config = new YamlConfiguration();
+        try {
+            config.load(CONFIG_FILE);
+        } catch (IOException ignore) {
+        } catch (InvalidConfigurationException ex) {
+            Bukkit.getLogger().log(Level.SEVERE, "Could not load kobosh.yml, please correct your syntax errors", ex);
+            throw Throwables.propagate(ex);
+        }
+        config.options().header(HEADER);
+        config.options().copyDefaults(true);
+        
+        try {
+            config.save(CONFIG_FILE);
+        } catch (IOException ex) {
+            Bukkit.getLogger().log(Level.SEVERE, "Could not save kobosh.yml", ex);
+        }
+    }
+}
