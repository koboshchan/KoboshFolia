From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: koboshchan <lucaszhang1001@gmail.com>
Date: Tue, 19 May 2026 19:44:44 -0700
Subject: [PATCH] Add barrel-rows config

Adds barrel-rows config option (default 3, min 1, max 6).
BarrelBlockEntity dynamically uses KoboshConfig.barrelRows to set
container size and menu type.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>

diff --git a/src/main/java/com/kobosh/koboshfolia/KoboshConfig.java b/src/main/java/com/kobosh/koboshfolia/KoboshConfig.java
index 847c1b3868594425536e28b3c7ebda222300bb2f..b3c15349787abd4c55288bf0ebfa9cb1c51c2553 100644
--- a/src/main/java/com/kobosh/koboshfolia/KoboshConfig.java
+++ b/src/main/java/com/kobosh/koboshfolia/KoboshConfig.java
@@ -42,6 +42,8 @@ public final class KoboshConfig {
     public static String uptimeSeconds = "%value% seconds";
     public static String uptimeCommandOutput = "Server has been running for: %uptime%";
 
+    public static int barrelRows = 3;
+
     public static boolean tpsbarEnabled = true;
     public static boolean memoryBarEnabled = true;
     public static boolean regionbarEnabled = true;
@@ -173,6 +175,11 @@ public final class KoboshConfig {
         uptimeCommandOutput = config.getString("commands.uptime.output", uptimeCommandOutput);
         config.set("commands.uptime.output", uptimeCommandOutput);
 
+        barrelRows = config.getInt("barrel-rows", barrelRows);
+        if (barrelRows < 1) barrelRows = 1;
+        if (barrelRows > 6) barrelRows = 6;
+        config.set("barrel-rows", barrelRows);
+
         try {
             config.save(CONFIG_FILE);
         } catch (IOException ex) {
