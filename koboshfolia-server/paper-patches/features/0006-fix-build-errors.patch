+    private static List<BossBar.Color> readColorList(String path, List<BossBar.Color> defaults) {
+        List<String> raw = config.getStringList(path);
+        if (raw.isEmpty()) {
+            raw = colorsToNames(defaults);
+        }
+
+        List<BossBar.Color> parsed = new ArrayList<>();
+        for (String value : raw) {
+            try {
+                parsed.add(BossBar.Color.valueOf(value.toUpperCase(Locale.ROOT)));
+            } catch (IllegalArgumentException ignored) {
+            }
+        }
+
+        while (parsed.size() < 4) {
+            parsed.add(defaults.get(parsed.size()));
+        }
+
+        List<BossBar.Color> sanitized = parsed.subList(0, 4);
+        config.set(path, colorsToNames(sanitized));
+        return new ArrayList<>(sanitized);
+    }
+
+    private static List<String> colorsToNames(List<BossBar.Color> colors) {
+        List<String> names = new ArrayList<>(colors.size());
+        for (BossBar.Color color : colors) {
+            names.add(color.name());
+        }
+        return names;
+    }
+
+    private static List<BossBar.Color> defaultBarColors() {
+        return new ArrayList<>(Arrays.asList(
+                BossBar.Color.GREEN,
+                BossBar.Color.YELLOW,
+                BossBar.Color.RED,
+                BossBar.Color.PURPLE
+        ));
+    }
