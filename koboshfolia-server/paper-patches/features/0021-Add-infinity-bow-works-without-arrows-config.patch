From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: koboshchan <lucaszhang1001@gmail.com>
Date: Tue, 19 May 2026 19:45:33 -0700
Subject: [PATCH] Add infinity-bow-works-without-arrows config

When enabled, the infinity enchantment allows firing arrows even without
any arrows in inventory. BowItem uses KoboshConfig.infinityBowWorksWithoutArrows.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>

diff --git a/src/main/java/com/kobosh/koboshfolia/KoboshConfig.java b/src/main/java/com/kobosh/koboshfolia/KoboshConfig.java
index d59e76c5ff341ae4cb7a1fa4f621995455c802cf..40c5a50dd783c05a4982827009a3c3c246db7430 100644
--- a/src/main/java/com/kobosh/koboshfolia/KoboshConfig.java
+++ b/src/main/java/com/kobosh/koboshfolia/KoboshConfig.java
@@ -46,6 +46,7 @@ public final class KoboshConfig {
     public static int pistonBlockPushLimit = 12;
     public static int poweredRailActivationRange = 8;
     public static double hungerStarvationDamage = 1.0;
+    public static boolean infinityBowWorksWithoutArrows = false;
 
     public static boolean tpsbarEnabled = true;
     public static boolean memoryBarEnabled = true;
@@ -195,6 +196,9 @@ public final class KoboshConfig {
         if (hungerStarvationDamage < 0.0) hungerStarvationDamage = 0.0;
         config.set("hunger-starvation-damage", hungerStarvationDamage);
 
+        infinityBowWorksWithoutArrows = config.getBoolean("infinity-bow-works-without-arrows", infinityBowWorksWithoutArrows);
+        config.set("infinity-bow-works-without-arrows", infinityBowWorksWithoutArrows);
+
         try {
             config.save(CONFIG_FILE);
         } catch (IOException ex) {
