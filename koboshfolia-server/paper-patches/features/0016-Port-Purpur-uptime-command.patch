From: koboshchan <lucaszhang1001@gmail.com>
Date: Tue, 19 May 2026 19:44:31 -0700
Subject: [PATCH] Port Purpur uptime command

Adds /uptime command that shows how long the server has been running.
Output format and time-unit strings are configurable in kobosh.yml
under commands.uptime. Uses MinecraftServer.startTimeMillis.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>

diff --git a/src/main/java/com/kobosh/koboshfolia/KoboshConfig.java b/src/main/java/com/kobosh/koboshfolia/KoboshConfig.java
index c7c7898cd4b9518976e5f3fa8cac22856b70b20a..847c1b3868594425536e28b3c7ebda222300bb2f 100644
--- a/src/main/java/com/kobosh/koboshfolia/KoboshConfig.java
+++ b/src/main/java/com/kobosh/koboshfolia/KoboshConfig.java
@@ -30,6 +30,18 @@ public final class KoboshConfig {
     public static float commandCompassBarProgressPercent = 1.0f;
     public static int commandCompassBarTickInterval = 5;
 
+    // Uptime command
+    public static String uptimeFormat = "%days% %hours% %minutes% %seconds%";
+    public static String uptimeDay = "%value% day";
+    public static String uptimeDays = "%value% days";
+    public static String uptimeHour = "%value% hour";
+    public static String uptimeHours = "%value% hours";
+    public static String uptimeMinute = "%value% minute";
+    public static String uptimeMinutes = "%value% minutes";
+    public static String uptimeSecond = "%value% second";
+    public static String uptimeSeconds = "%value% seconds";
+    public static String uptimeCommandOutput = "Server has been running for: %uptime%";
+
     public static boolean tpsbarEnabled = true;
     public static boolean memoryBarEnabled = true;
     public static boolean regionbarEnabled = true;
@@ -139,6 +151,28 @@ public final class KoboshConfig {
         if (commandCompassBarTickInterval < 1) commandCompassBarTickInterval = 1;
         config.set("commands.compass.tick-interval", commandCompassBarTickInterval);
 
+        // Uptime command
+        uptimeFormat = config.getString("commands.uptime.format", uptimeFormat);
+        config.set("commands.uptime.format", uptimeFormat);
+        uptimeDay = config.getString("commands.uptime.day", uptimeDay);
+        config.set("commands.uptime.day", uptimeDay);
+        uptimeDays = config.getString("commands.uptime.days", uptimeDays);
+        config.set("commands.uptime.days", uptimeDays);
+        uptimeHour = config.getString("commands.uptime.hour", uptimeHour);
